set_property IOSTANDARD LVCMOS33 [get_ports *]
# Clock
create_clock -period 12.000 -name sys_clk [get_ports clk]

# I/O timing
set_input_delay -clock sys_clk -max 2.000 [get_ports -filter {DIRECTION == IN && NAME != clk}]
set_input_delay -clock sys_clk -min 0.000 [get_ports -filter {DIRECTION == IN && NAME != clk}]
set_output_delay -clock sys_clk -max 2.000 [all_outputs]
set_output_delay -clock sys_clk -min 0.000 [all_outputs]

# I/O standard for all ports (clears NSTD-1)

# Bitstream configuration settings
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]

# Allow bitstream without pin locations (UCIO-1)

set_property PACKAGE_PIN P17 [get_ports acc_en]
set_property PACKAGE_PIN B17 [get_ports {accumulator[0]}]
set_property PACKAGE_PIN C16 [get_ports {accumulator[1]}]
set_property PACKAGE_PIN B15 [get_ports {accumulator[2]}]
set_property PACKAGE_PIN C15 [get_ports {accumulator[3]}]
set_property PACKAGE_PIN A16 [get_ports {accumulator[4]}]
set_property PACKAGE_PIN B16 [get_ports {accumulator[5]}]
set_property PACKAGE_PIN A15 [get_ports {accumulator[6]}]
set_property PACKAGE_PIN A14 [get_ports {accumulator[7]}]
set_property PACKAGE_PIN R19 [get_ports {alu_result[0]}]
set_property PACKAGE_PIN P18 [get_ports {alu_result[1]}]
set_property PACKAGE_PIN N17 [get_ports {alu_result[2]}]
set_property PACKAGE_PIN P19 [get_ports {alu_result[3]}]
set_property PACKAGE_PIN N19 [get_ports {alu_result[4]}]
set_property PACKAGE_PIN L17 [get_ports {alu_result[5]}]
set_property PACKAGE_PIN K17 [get_ports {alu_result[6]}]
set_property PACKAGE_PIN L18 [get_ports {alu_result[7]}]
set_property PACKAGE_PIN C17 [get_ports {alu_sel[0]}]
set_property PACKAGE_PIN A18 [get_ports {alu_sel[1]}]
set_property PACKAGE_PIN B18 [get_ports {alu_sel[2]}]
set_property PACKAGE_PIN K18 [get_ports clk]
set_property PACKAGE_PIN U14 [get_ports {data_in[0]}]
set_property PACKAGE_PIN W16 [get_ports {data_in[1]}]
set_property PACKAGE_PIN W15 [get_ports {data_in[2]}]
set_property PACKAGE_PIN W14 [get_ports {data_in[3]}]
set_property PACKAGE_PIN V14 [get_ports {data_in[4]}]
