set_property PACKAGE_PIN U15 [get_ports {data_in[6]}]
set_property PACKAGE_PIN V17 [get_ports {data_in[7]}]
set_property PACKAGE_PIN V19 [get_ports load_en]
set_property PACKAGE_PIN N18 [get_ports {load_reg_out[0]}]
set_property PACKAGE_PIN M17 [get_ports {load_reg_out[1]}]
set_property PACKAGE_PIN M19 [get_ports {load_reg_out[2]}]
set_property PACKAGE_PIN L19 [get_ports {load_reg_out[3]}]
